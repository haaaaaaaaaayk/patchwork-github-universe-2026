# Bright Data is optional for the local demo. Create a Web Unlocker zone and
# set the API key and exact zone name from your Bright Data account.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

# Optional FalkorDB connection. Use a reachable instance URL; the example local
# URL only works when a FalkorDB server is running on this machine.
# FALKORDB_URL=falkor://localhost:6379
# Cloud connections use the host and port shown in FalkorDB Cloud's Connect panel.
# FALKORDB_HOST=your-cloud-endpoint
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=patchwork
# FALKORDB_PASSWORD=
# Remote connections should use TLS. Plain TCP requires explicit opt-in.
# FALKORDB_ALLOW_INSECURE=true
PORT=4173
